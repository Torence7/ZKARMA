+# --- PKI hook (ZKARMA_TRUST_BUNDLE set): adapters from integration/pki_adapters.py ---
+def _pki():
+    import os, sys
+    from config import ROOT
+    if not os.environ.get("ZKARMA_TRUST_BUNDLE"):
+        return None
+    sys.path.insert(0, str(ROOT / "pki"))
+    from zkarma_pki import TrustStore
+    return TrustStore.from_bundle(os.environ["ZKARMA_TRUST_BUNDLE"])
+
+
 def check_signature(message: dict) -> bool:
+    trust = _pki()
+    if trust is not None:
+        from integration.pki_adapters import verify_website_message
+        from zkarma_pki import VerificationError
+        if message.get("signature") is None:
+            raise Refused("unsigned")
+        try:
+            verify_website_message(message, message["signature"], trust,
+                                   message.get("origin", message.get("site")), spec.signed_payload)
+        except VerificationError:
+            raise Refused("bad_website_signature") from None
+        return True
+    return _stub_check_signature(message)
+
+
+def _stub_check_signature(message: dict) -> bool:
     """True if signed, False if unsigned and dev mode allows that. Raises otherwise.
     STUB: spec.stub_verify until the PKI gives us the website's key."""
     sig = message.get("signature")
